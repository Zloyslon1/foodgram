# Скопируйте в .env и заполните реальными значениями
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,foodgram.example.org
CSRF_TRUSTED_ORIGINS=https://foodgram.example.org

# PostgreSQL
POSTGRES_DB=foodgram
POSTGRES_USER=foodgram_user
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# True — использовать SQLite вместо PostgreSQL (только для локальной разработки)
USE_SQLITE=False
